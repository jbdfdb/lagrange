# Lagrange - Configuration Environment
# Copy this file to .env and adjust values

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Security
SECRET_KEY=change-this-to-a-random-secret-key

# Application
APP_NAME=Lagrange - Systeme Solaire
LOG_LEVEL=INFO
